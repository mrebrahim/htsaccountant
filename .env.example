# Supabase Postgres connection string (use the transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Long random string used to sign session tokens
JWT_SECRET=change-me-to-a-long-random-string
# Optional: Facebook Ads token (can also be set from the settings page by an admin)
FB_ACCESS_TOKEN=
PORT=3001
